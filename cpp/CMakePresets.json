{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-runtime-debug",
      "displayName": "Linux bundled runtime (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/cpp-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "${sourceDir}/../runtime/linux/python"
      }
    },
    {
      "name": "linux-runtime-release",
      "inherits": "linux-runtime-debug",
      "displayName": "Linux bundled runtime (Release)",
      "binaryDir": "${sourceDir}/../build/cpp-release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    }
  ],
  "buildPresets": [
    {"name": "linux-debug", "configurePreset": "linux-runtime-debug"},
    {"name": "linux-release", "configurePreset": "linux-runtime-release"}
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-runtime-debug",
      "output": {"outputOnFailure": true}
    }
  ]
}
