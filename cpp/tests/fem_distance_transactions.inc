void distance_transactions() {
    auto part=document::PartDocument::create_default();auto feature=test::rectangular_feature(part,{20,10,5});part.history={feature};
    document::BodyHistoryGraph graph;const auto source_id=graph.create_body("Stock");graph.insert({document::PartHistoryKind::Feature,feature.id});part.set_body_history(graph);
    kernel::OcctKernel kernel;auto calculated=kernel.evaluate_history(part.kernel_operations());
    workspace::Workspace live;live.add_part(part,std::move(calculated));auto& session=live.open_part(part.document_id)->session;
    auto edit=workspace::prepare_fem_edit(session.document());document::BodyHistory fem;fem.scope.id=edit.object_id;fem.name="Analysis";fem.fem=document::FemDefinition{source_id};
    require(workspace::commit_fem(live,edit,fem),"Distance fixture FEM missing");
    const auto count=kernel::body_calculation_count.load();const auto source=workspace::read_fem_source(session,fem.scope.id);
    const auto commit=[&](document::FemCondition c){return workspace::commit_fem_condition(live,workspace::prepare_fem_edit(session.document(),fem.scope.id),c);};
    const auto stored=[&](const std::string& id){return *workspace::find_fem_condition(session.document(),fem.scope.id,id);};
    document::FemCondition a;a.id="point-a";a.name="A";a.kind=document::FemConditionKind::MeasurementPoint;a.placement.x=2;
    auto b=a;b.id="point-b";b.name="B";b.placement.x=12;b.visible=false;
    require(commit(a)&&commit(b),"Distance points missing");
    auto load=a;load.id="load";load.name="Load";load.kind=document::FemConditionKind::Force;
    require(commit(load),"Wrong-kind reference fixture missing");
    document::FemCondition distance;distance.id="distance";distance.name="Distance";distance.kind=document::FemConditionKind::MeasurementDistance;
    distance.distance=document::FemDistanceMeasurement{{a.id,b.id}};
    require(commit(distance),"Distance did not commit");distance=stored(distance.id);
    require(distance.distance->reference_valid&&distance.distance->positions[0].x==2&&distance.distance->positions[1].x==12,"Distance did not resolve hidden point");
    const auto revision=session.revision();require(!commit(distance)&&session.revision()==revision,"Unchanged distance created Undo");
    auto invalid=distance;invalid.distance->point_ids[1]="missing";rejects([&]{commit(invalid);});
    invalid.distance->point_ids[1]=a.id;rejects([&]{commit(invalid);});
    invalid.distance->point_ids[1]=distance.id;rejects([&]{commit(invalid);});
    invalid.distance->point_ids[1]=load.id;rejects([&]{commit(invalid);});
    require(session.revision()==revision,"Invalid distance modified document");
    b.placement.x=14;require(commit(b),"Distance point edit failed");require(stored(distance.id).distance->positions[1].x==14,"Distance did not follow point edit");
    require(session.undo()&&stored(distance.id)==distance,"Distance point Undo failed");require(session.redo(),"Distance point Redo failed");
    distance=stored(distance.id);const auto positions=distance.distance->positions;
    require(workspace::erase_fem_condition(live,workspace::prepare_fem_edit(session.document(),fem.scope.id),b.id),"Distance point deletion failed");
    require(!stored(distance.id).distance->reference_valid&&stored(distance.id).distance->positions==positions,"Deleted point moved distance");
    a.placement.x=4;require(commit(a),"Remaining point edit failed");
    require(stored(distance.id).distance->positions==positions,"Broken distance moved one endpoint");
    const auto path=std::filesystem::temp_directory_path()/"zima-fem-distance-test.prtz";
    session.document().save(path,session.calculated_boundaries());const auto restored=document::PartDocument::load(path);std::filesystem::remove(path);
    require(restored.body_history==session.document().body_history,"Broken distance native persistence failed");
    require(session.undo()&&session.undo(),"Deleted point Undo failed");
    require(stored(distance.id).distance->reference_valid&&stored(distance.id).distance->positions==positions,"Undo did not restore distance identity");
    require(session.redo()&&session.redo(),"Deleted point Redo failed");
    auto c=b;c.id="replacement";c.name="Replacement";c.placement.x=18;require(commit(c),"Replacement point missing");
    distance=stored(distance.id);distance.distance->point_ids[1]=c.id;require(commit(distance),"Distance repair failed");
    distance=stored(distance.id);require(distance.distance->reference_valid&&distance.distance->positions[0].x==4&&distance.distance->positions[1].x==18,"Repaired distance did not resolve both points");
    auto damaged=session.document();auto body=*damaged.body_history.find(fem.scope.id);
    auto& point=*std::ranges::find(body.fem->conditions,a.id,&document::FemCondition::id);
    point.placement.references={{"","removed-source","origin:point",0,false}};damaged.body_history.update_body(body);
    const auto retained=distance.distance->positions;damaged.resolve_constructions({});
    const auto* broken=workspace::find_fem_condition(damaged,fem.scope.id,distance.id);
    require(!broken->distance->reference_valid&&broken->distance->positions==retained,"Lost placement reference moved distance endpoints");
    require(nlohmann::json(*damaged.body_history.find(fem.scope.id)->fem).get<document::FemDefinition>()==*damaged.body_history.find(fem.scope.id)->fem,"Broken distance definition persistence failed");
    require(kernel::body_calculation_count.load()==count&&workspace::read_fem_source(session,fem.scope.id).shares_with(source),"Distance edits recalculated CAD");
    std::cout<<"FEM distance: metadata-only edit, hidden points, reference loss/repair, atomic validation, Undo/Redo and native persistence passed\n";
}
