# Python generated files
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and IDE-local state
.venv/
venv/
.idea/
.vscode/
*.user

# Packaged runtimes and build outputs
runtime/windows/python/
runtime/windows/*.zip
runtime/windows/.python-candidate-*/
runtime/windows/.python-previous-*/
runtime/linux/python/
runtime/linux/*.tar*
build/
builds/
dist/
.dist-output/
*.egg-info/

# User CAD documents stay local and are never modified by Git
Projects/**

# OS-generated files
Thumbs.db
Desktop.ini
.DS_Store
.cpp-python-manual-fixtures/
screenshots/

# Working artifacts left behind by --verify-startup when run from the repo root
/*-STARTUP-*.prtz
/*-STARTUP-*.asmz
/*-STARTUP-*.drwz
/*-STARTUP-*.prtz.*
/*-STARTUP-*.asmz.*
/*-STARTUP-*.drwz.*

# Numbered local settings/library backups (keep current assets tracked)
/config/**/*.ini.[0-9]*
/config/**/*.prtz.[0-9]*
/config/**/*.asmz.[0-9]*
/config/**/*.drwz.[0-9]*
/config/**/*.tblz.[0-9]*
/config/**/*.frmz.[0-9]*
/config/**/*.symz.[0-9]*

# Native verification scratch documents written in the repository root
/helical-noop.prtz
/owned-profile-frame.prtz
/owned-profile-frame.prtz.[0-9]*
/other-profile-plane.prtz
/other-profile-plane.prtz.[0-9]*
/zima-cpp-workspace-lifecycle.prtz.[0-9]*
