#!/usr/bin/env bash
set -euo pipefail

zima_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

for executable in \
    "$zima_root/build/cpp-debug/zima-cad-cpp" \
    "$zima_root/build/cpp-release/zima-cad-cpp"
do
    if [[ -x "$executable" ]]; then
        exec "$executable" "$@"
    fi
done

echo "ZIMA-CAD C++ executable was not found." >&2
echo "Build it with:" >&2
echo "  cmake --preset linux-runtime-debug -S cpp" >&2
echo "  cmake --build build/cpp-debug --target zima-cad-cpp" >&2
exit 1
